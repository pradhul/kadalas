# Toggle mock Google/Drive/Gmail/AI services (default true in app.json extra.useMocks)
EXPO_PUBLIC_USE_MOCKS=true

# Google OAuth client IDs — create in Google Cloud Console (see README)
# Never commit real client secrets. OAuth client IDs for public clients are OK in env,
# but keep any client secret out of the repo (mobile/web PKCE flows should not need one).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
