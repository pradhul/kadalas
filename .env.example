# Copy to `.env` for local overrides. Never commit `.env`.
# Mock mode needs no Google or AI credentials.
#
# These EXPO_PUBLIC_* values are read at build time (embedded in the bundle).
# Set them in the shell when running `npm run build:web`.

# Toggle mock Google Drive / Gmail / AI (default true via app.json extra.useMocks)
EXPO_PUBLIC_USE_MOCKS=true

# Google OAuth client IDs from Google Cloud Console (public clients — PKCE).
# Leave blank in mock mode. Do NOT put client secrets here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=

# Web uses Google Identity Services token client (no client_secret).
# Authorize each deploy host under Authorized JavaScript origins in Google Cloud.

# AI keys are entered in-app (Settings) and stored on-device via
# expo-secure-store / localStorage — do not put them in this file.
